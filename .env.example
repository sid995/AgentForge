# Local development configuration for AgentForge through Phase 5.
# Copy this file to .env. The example credentials are local-only defaults.

# Platform API runtime
AGENTFORGE_HTTP_ADDR=:8080
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_SHUTDOWN_TIMEOUT=10s
AGENTFORGE_REQUEST_TIMEOUT=30s
AGENTFORGE_MAX_REQUEST_BODY_BYTES=1048576

# PostgreSQL connection and pool controls
AGENTFORGE_DATABASE_URL=postgres://agentforge_migrator:agentforge-migrator@127.0.0.1:15432/agentforge?sslmode=disable
AGENTFORGE_DATABASE_MAX_CONNS=10
AGENTFORGE_DATABASE_MAX_IDLE_CONNS=5
AGENTFORGE_DATABASE_MAX_CONN_LIFETIME=30m
AGENTFORGE_DATABASE_ACQUIRE_TIMEOUT=5s
AGENTFORGE_DATABASE_CONNECT_TIMEOUT=5s

# Scheduler cluster selection
AGENTFORGE_SCHEDULER_STRATEGY=least-loaded

# Scheduler process, workers, leases, and optional Kafka wake hints
AGENTFORGE_SCHEDULER_HTTP_ADDR=:8081
AGENTFORGE_SCHEDULER_OWNER=scheduler-local
AGENTFORGE_SCHEDULER_POLL_INTERVAL=2s
AGENTFORGE_SCHEDULER_LEASE_DURATION=30s
AGENTFORGE_SCHEDULER_BATCH_SIZE=10
AGENTFORGE_SCHEDULER_WORKERS=4
AGENTFORGE_SCHEDULER_WORK_QUEUE_SIZE=16
AGENTFORGE_SCHEDULER_AGING_INTERVAL=1m
AGENTFORGE_SCHEDULER_MAX_AGING_BOOST=20
AGENTFORGE_SCHEDULER_CLUSTER_FRESHNESS=30s
AGENTFORGE_SCHEDULER_RESERVATION_TTL=5m
AGENTFORGE_SCHEDULER_DEFERRAL_DURATION=30s
AGENTFORGE_SCHEDULER_KAFKA_HINTS_ENABLED=false
AGENTFORGE_SCHEDULER_KAFKA_GROUP=agentforge-scheduler-hints-v1

# Kafka-compatible event transport
AGENTFORGE_KAFKA_BROKERS=127.0.0.1:19092
AGENTFORGE_KAFKA_CLIENT_ID=agentforge-platform-api
AGENTFORGE_KAFKA_PUBLISH_TIMEOUT=10s
AGENTFORGE_KAFKA_MAX_ATTEMPTS=3
AGENTFORGE_KAFKA_MAX_MESSAGE_BYTES=1048576

# Broker integration-test only; `make test-events-integration` supplies this.
AGENTFORGE_TEST_KAFKA_BROKERS=127.0.0.1:29092

# Integration-test only; `make test-integration` supplies these values itself.
AGENTFORGE_TEST_DATABASE_URL=postgres://agentforge_migrator:agentforge-migrator@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_APP_DATABASE_URL=postgres://agentforge_app:agentforge-app@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_RELAY_DATABASE_URL=postgres://agentforge_relay:agentforge-relay@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_SCHEDULER_DATABASE_URL=postgres://agentforge_scheduler:agentforge-scheduler@127.0.0.1:25432/agentforge?sslmode=disable

# Root docker-compose.yml PostgreSQL service
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge_migrator
POSTGRES_PASSWORD=agentforge-migrator
POSTGRES_APP_PASSWORD=agentforge-app
POSTGRES_RELAY_PASSWORD=agentforge-relay
POSTGRES_SCHEDULER_PASSWORD=agentforge-scheduler
POSTGRES_HOST_PORT=15432
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=512m

# Root docker-compose.yml Redpanda service
COMPOSE_PROJECT_NAME=agentforge
REDPANDA_HOST_PORT=19092
REDPANDA_CPUS=1.0
REDPANDA_MEMORY_LIMIT=1g

# Root docker-compose.yml Scheduler service
SCHEDULER_HOST_PORT=18081
SCHEDULER_CPUS=0.5
SCHEDULER_MEMORY_LIMIT=256m

# Optional build metadata passed to the Platform API and Scheduler image builds
BUILD_VERSION=development
BUILD_COMMIT=unknown
BUILD_TIME=unknown
