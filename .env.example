# Local development configuration for AgentForge through Phase 8, including
# Agent Runner and artifact-service integration-test settings.
# Copy this file to .env. The example credentials are local-only defaults.

# Platform API runtime
AGENTFORGE_HTTP_ADDR=:8080
AGENTFORGE_ENVIRONMENT=development
AGENTFORGE_SHUTDOWN_TIMEOUT=10s
AGENTFORGE_REQUEST_TIMEOUT=30s
AGENTFORGE_MAX_REQUEST_BODY_BYTES=1048576

# Optional Phase 3.3 local-only API identity. Set all four values only for
# AGENTFORGE_ENVIRONMENT=development or test; never commit a real token.
# AGENTFORGE_DEVELOPMENT_IDENTITY_TOKEN=replace-with-local-opaque-token
# AGENTFORGE_DEVELOPMENT_IDENTITY_TENANT_ID=00000000-0000-0000-0000-000000000000
# AGENTFORGE_DEVELOPMENT_IDENTITY_SUBJECT=developer@example.test
# AGENTFORGE_DEVELOPMENT_IDENTITY_ROLE=developer

# Optional Phase 8.3 Platform API artifact-download storage. Configure all
# required values together; values are server-only and are never client input.
# AGENTFORGE_ARTIFACT_S3_ENDPOINT=127.0.0.1:19000
# AGENTFORGE_ARTIFACT_S3_ACCESS_KEY=replace-with-server-access-key
# AGENTFORGE_ARTIFACT_S3_SECRET_KEY=replace-with-server-secret-key
# AGENTFORGE_ARTIFACT_S3_BUCKET=agentforge-artifacts
# AGENTFORGE_ARTIFACT_S3_PREFIX=development
# AGENTFORGE_ARTIFACT_S3_SECURE=false

# PostgreSQL connection and pool controls
AGENTFORGE_DATABASE_URL=postgres://agentforge_migrator:agentforge-migrator@127.0.0.1:15432/agentforge?sslmode=disable
AGENTFORGE_DATABASE_MAX_CONNS=10
AGENTFORGE_DATABASE_MAX_IDLE_CONNS=5
AGENTFORGE_DATABASE_MAX_CONN_LIFETIME=30m
AGENTFORGE_DATABASE_ACQUIRE_TIMEOUT=5s
AGENTFORGE_DATABASE_CONNECT_TIMEOUT=5s

# Scheduler cluster selection
AGENTFORGE_SCHEDULER_STRATEGY=least-loaded

# Scheduler process, workers, leases, and optional Kafka wake hints
AGENTFORGE_SCHEDULER_HTTP_ADDR=:8081
AGENTFORGE_SCHEDULER_OWNER=scheduler-local
AGENTFORGE_SCHEDULER_POLL_INTERVAL=2s
AGENTFORGE_SCHEDULER_LEASE_DURATION=30s
AGENTFORGE_SCHEDULER_BATCH_SIZE=10
AGENTFORGE_SCHEDULER_WORKERS=4
AGENTFORGE_SCHEDULER_WORK_QUEUE_SIZE=16
AGENTFORGE_SCHEDULER_AGING_INTERVAL=1m
AGENTFORGE_SCHEDULER_MAX_AGING_BOOST=20
AGENTFORGE_SCHEDULER_CLUSTER_FRESHNESS=30s
AGENTFORGE_SCHEDULER_RESERVATION_TTL=5m
AGENTFORGE_SCHEDULER_DEFERRAL_DURATION=30s
AGENTFORGE_SCHEDULER_KAFKA_HINTS_ENABLED=false
AGENTFORGE_SCHEDULER_KAFKA_GROUP=agentforge-scheduler-hints-v1
AGENTFORGE_SCHEDULER_RUNNER_IMAGES={"python-3.12":"docker.io/library/busybox@sha256:9532d8c39891ca2ecde4d30d7710e01fb739c87a8b9299685c63704296b16028"}
AGENTFORGE_SCHEDULER_WORKSPACE_SIZE_GIB=10
AGENTFORGE_SCHEDULER_STORAGE_CLASS=standard
AGENTFORGE_SCHEDULER_ARTIFACT_DESTINATION_REF=artifact-store
AGENTFORGE_SCHEDULER_CONFIGURATION_REFS=
AGENTFORGE_SCHEDULER_SECRET_REFS=

# AgentRun handoff process and explicit cluster-to-kubeconfig context mapping
AGENTFORGE_HANDOFF_HTTP_ADDR=:8082
AGENTFORGE_HANDOFF_PROCESS_TIMEOUT=30s
AGENTFORGE_HANDOFF_KAFKA_GROUP=agentforge-agentrun-handoff-v1
AGENTFORGE_HANDOFF_KUBECONFIG=./.local/kubeconfig/config
AGENTFORGE_HANDOFF_CLUSTER_CONTEXTS={"cluster-local":"kind-agentforge"}
AGENTFORGE_HANDOFF_QUARANTINE_TENANT_ID=019b0000-0000-7000-8000-000000000001

# Kafka-compatible event transport
AGENTFORGE_KAFKA_BROKERS=127.0.0.1:19092
AGENTFORGE_KAFKA_CLIENT_ID=agentforge-platform-api
AGENTFORGE_KAFKA_PUBLISH_TIMEOUT=10s
AGENTFORGE_KAFKA_MAX_ATTEMPTS=3
AGENTFORGE_KAFKA_MAX_MESSAGE_BYTES=1048576

# Broker integration-test only; `make test-events-integration` supplies this.
AGENTFORGE_TEST_KAFKA_BROKERS=127.0.0.1:29092

# Integration-test only; `make test-integration` supplies these values itself.
AGENTFORGE_TEST_DATABASE_URL=postgres://agentforge_migrator:agentforge-migrator@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_APP_DATABASE_URL=postgres://agentforge_app:agentforge-app@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_RELAY_DATABASE_URL=postgres://agentforge_relay:agentforge-relay@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_SCHEDULER_DATABASE_URL=postgres://agentforge_scheduler:agentforge-scheduler@127.0.0.1:25432/agentforge?sslmode=disable
AGENTFORGE_TEST_HANDOFF_DATABASE_URL=postgres://agentforge_handoff:agentforge-handoff@127.0.0.1:25432/agentforge?sslmode=disable

# Root docker-compose.yml PostgreSQL service
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge_migrator
POSTGRES_PASSWORD=agentforge-migrator
POSTGRES_APP_PASSWORD=agentforge-app
POSTGRES_RELAY_PASSWORD=agentforge-relay
POSTGRES_SCHEDULER_PASSWORD=agentforge-scheduler
POSTGRES_HANDOFF_PASSWORD=agentforge-handoff
POSTGRES_HOST_PORT=15432
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=512m

# Root docker-compose.yml Redpanda service
COMPOSE_PROJECT_NAME=agentforge
REDPANDA_HOST_PORT=19092
REDPANDA_CPUS=1.0
REDPANDA_MEMORY_LIMIT=1g

# Root docker-compose.yml Scheduler service
SCHEDULER_HOST_PORT=18081
SCHEDULER_CPUS=0.5
SCHEDULER_MEMORY_LIMIT=256m

# Root docker-compose.yml AgentRun handoff service (`--profile kubernetes`)
HANDOFF_HOST_PORT=18082
HANDOFF_CPUS=0.5
HANDOFF_MEMORY_LIMIT=256m

# Root docker-compose.yml MinIO runner-artifact test service (`--profile runner`)
RUNNER_MINIO_HOST_PORT=19000
RUNNER_MINIO_CPUS=0.5
RUNNER_MINIO_MEMORY_LIMIT=256m
RUNNER_MINIO_ROOT_USER=agentforge-runner
RUNNER_MINIO_ROOT_PASSWORD=agentforge-runner-secret

# Operator golden-manifest test helper; set to 1 only when intentionally
# printing regenerated golden output.
AGENTFORGE_PRINT_GOLDEN=0

# The Operator injects these fixed values into runner Pods. They are documented
# here for completeness and are not read from the developer shell or Compose.
# AGENTFORGE_RUN_CONFIG=/etc/agentforge/runtime/config.json
# AGENTFORGE_WORKSPACE=/workspace

# Optional build metadata passed to Platform API, Scheduler, and handoff builds
BUILD_VERSION=development
BUILD_COMMIT=unknown
BUILD_TIME=unknown
